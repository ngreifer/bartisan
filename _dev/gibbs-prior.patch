+# The Gibbs prior of Linero and Du (2023), behind `sparsity = "gibbs"`.
+#
+# What is checked here is the wiring, not the statistics. Whether the urn makes
+# fewer false selections than the Dirichlet prior is a claim about fits and is
+# measured in `_dev/gibbs-prior-smoke.R`, where it can afford the replicates;
+# at a size a test can afford, the DART and Gibbs counts overlap on a single
+# seed and an assertion on their difference would be testing the noise.
+#
+# What *is* deterministic enough to assert is that the option is accepted and
+# refused in the right places, that `zeta` reaches the sampler and moves the
+# model size in the documented direction, and that the urn does not disturb the
+# Dirichlet path it sits beside.
+
+sim_null_p <- function(seed, n = 250L, p = 12L) {
+  set.seed(seed)
+  x <- matrix(stats::runif(n * p), n, p,
+              dimnames = list(NULL, paste0("x", seq_len(p))))
+  data.frame(y = stats::rnorm(n, 0, 1), x)
+}
+
+# How many predictors the median probability model keeps.
+n_selected <- function(fit) {
+  imp <- variable_importance(fit)
+  sum(imp[["prop_used"]] >= 0.5)
+}
+
+gibbs_control <- function(...) {
+  quick_control(num_trees = 10L, num_burn = 100L, num_draws = 200L, ...)
+}
+
+test_that("`sparsity = \"gibbs\"` is accepted and turns the Dirichlet draws off", {
+  ctl <- bartisan_control(sparsity = "gibbs")
+
+  expect_true(ctl[["gibbs"]])
+  expect_equal(ctl[["zeta"]], 1)
+
+  # There are no proportions and no concentration under the Gibbs prior: both
+  # are marginalized into the urn, so nothing draws them.
+  expect_false(any(ctl[["update_s"]]))
+  expect_false(any(ctl[["update_alpha"]]))
+
+  # And the levels beside it are untouched.
+  expect_false(any(bartisan_control(sparsity = TRUE)[["gibbs"]]))
+  expect_false(any(bartisan_control(sparsity = FALSE)[["gibbs"]]))
+  expect_true(any(bartisan_control(sparsity = TRUE)[["update_s"]]))
+
+  # Per-forest, like every other `sparsity` value.
+  per <- bartisan_control(sparsity = c("gibbs", "none"))
+  expect_equal(unname(per[["gibbs"]]), c(TRUE, FALSE))
+})
+
+test_that("`zeta` is validated", {
+  expect_equal(bartisan_control(zeta = 2.5)[["zeta"]], 2.5)
+  expect_equal(bartisan_control(zeta = 0)[["zeta"]], 0)
+
+  expect_error(bartisan_control(zeta = -1), "non-negative")
+  expect_error(bartisan_control(zeta = "1"), "number")
+  expect_error(bartisan_control(zeta = c(1, 2)), "number")
+})
+
+test_that("the Gibbs prior is refused where it has nothing to mean", {
+  # `split_prior` fixes the splitting proportions and the Gibbs prior does not
+  # have proportions to fix. Checked before `split_prior` turns `sparsity` off,
+  # which would otherwise leave nothing to detect.
+  expect_error(bartisan_control(sparsity = "gibbs", split_prior = c(x1 = 3)),
+               "cannot both")
+
+  # `share_sparsity` pools counts behind one Dirichlet draw, and there is no
+  # such draw here.
+  expect_error(bartisan_control(sparsity = "gibbs", share_sparsity = TRUE),
+               "not available")
+})
+
+test_that("a shared topology refuses the Gibbs prior rather than mis-sampling", {
+  # `update_shared_forests()` draws one rule for a whole group of trees and
+  # never refreshes the urn counts, so without this guard the urn would read
+  # all zeros and quietly return the wrong prior. The error comes from C++.
+  d <- sim_x(n = 120, p = 4)
+  d[["y"]] <- stats::rnorm(120)
+
+  expect_error(
+    with_shared_forests(
+      bartisan(list(y ~ ., ~ .), d, family = gaussian_ls(),
+               control = gibbs_control(sparsity = "gibbs"))
+    ),
+    "share_forests"
+  )
+})
+
+test_that("a Gibbs fit runs, and is not either Dirichlet path in disguise", {
+  d <- sim_null_p(1L)
+
+  fit_of <- function(sparsity) {
+    set.seed(11L)
+    bartisan(y ~ ., d, family = gaussian(),
+             control = gibbs_control(sparsity = sparsity))
+  }
+
+  gibbs <- fit_of("gibbs")
+  dart <- fit_of(TRUE)
+  flat <- fit_of(FALSE)
+
+  expect_s3_class(gibbs, "bartisan_fit")
+  expect_true(all(is.finite(fitted(gibbs))))
+  expect_predictor_invariant(gibbs, d)
+
+  # Same data, same seed, a different prior over which predictor a rule names,
+  # so the fits must differ. Equality here would mean the urn is never reached.
+  expect_false(isTRUE(all.equal(fitted(gibbs), fitted(dart))))
+  expect_false(isTRUE(all.equal(fitted(gibbs), fitted(flat))))
+})
+
+test_that("`zeta` reaches the sampler and shrinks the model size", {
+  # Calibrated rather than guessed. Over eight seeds on this design, `zeta = 8`
+  # kept exactly one predictor every time (sd 0), while `zeta = 0` ranged from
+  # one to six. The assertions below sit well outside that band: a `zeta = 8`
+  # fit keeping three predictors would be far outside anything observed.
+  for (seed in c(3L, 5L)) {
+    d <- sim_null_p(seed)
+
+    set.seed(2000L + seed)
+    tight <- bartisan(y ~ ., d, family = gaussian(),
+                      control = gibbs_control(sparsity = "gibbs", zeta = 8))
+
+    set.seed(2000L + seed)
+    loose <- bartisan(y ~ ., d, family = gaussian(),
+                      control = gibbs_control(sparsity = "gibbs", zeta = 0))
+
+    expect_lte(n_selected(tight), 3L)
+    expect_lte(n_selected(tight), n_selected(loose))
+  }
+})
+
+test_that("the urn respects a single predictor and an intercept-only forest", {
+  # `log_v()` sums over d in 1..P, so P = 1 is the edge where that sum has one
+  # term and t can be 0 or 1. It must not return a non-finite weight.
+  d <- sim_x(n = 100, p = 1)
+  d[["y"]] <- 2 * d[["x1"]] + stats::rnorm(100, 0, 0.3)
+
+  one <- bartisan(y ~ x1, d, family = gaussian(),
+                  control = gibbs_control(sparsity = "gibbs"))
+  expect_true(all(is.finite(fitted(one))))
+
+  # A pinned forest never births, so the urn is never asked for it. It cannot be
+  # the only forest -- a model with nothing to split on is refused -- so the
+  # case is a second forest held at `~ 1`, which is where `gamma` is zero and
+  # the constructor's `allowed_` fallback runs.
+  d2 <- sim_x(n = 150, p = 2)
+  d2[["y"]] <- 2 * d2[["x1"]] + stats::rnorm(150, 0, 0.3)
+
+  pinned <- bartisan(list(y ~ ., ~ 1), d2, family = gaussian_ls(),
+                     control = gibbs_control(sparsity = "gibbs"))
+  expect_true(all(is.finite(fitted(pinned))))
+})
+
+test_that("a Gibbs fit is reproducible", {
+  d <- sim_null_p(2L)
+
+  draw <- function() {
+    set.seed(707L)
+    bartisan(y ~ ., d, family = gaussian(),
+             control = gibbs_control(sparsity = "gibbs"))
+  }
+
+  expect_equal(fitted(draw()), fitted(draw()))
+})
