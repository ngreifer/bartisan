+void Hypers::set_urn_counts(const arma::uvec& counts) {
+  if (!gibbs) {
+    return;
+  }
+
+  urn_counts_ = arma::conv_to<arma::vec>::from(counts);
+  num_branches_ = arma::accu(urn_counts_.elem(allowed_));
+}
+
+// log V_B(t), Linero and Du (2023) equation (4):
+//
+//   V_B(t) = sum_{d = max(t, 1)}^{P} d! / (d - t)! * Gamma(alpha d) /
+//            Gamma(alpha d + B) * pi_D(d)
+//
+// computed in logs because both factorial ratios overflow and both gamma ratios
+// underflow well inside the range of P and B a real fit reaches. pi_D's
+// normalizing constant is dropped: the urn only ever takes ratios of V at a
+// fixed B, so it cancels.
+//
+// The sum starts at 1 rather than 0 because D is supported on {1, ..., P}, and
+// t = 0 is a legitimate argument -- it is what an empty ensemble asks for.
+double Hypers::log_v(int t, int branches) const {
+  std::pair<int, int> key(t, branches);
+  std::map<std::pair<int, int>, double>::const_iterator hit =
+    log_v_cache_.find(key);
+
+  if (hit != log_v_cache_.end()) {
+    return hit->second;
+  }
+
+  int p = static_cast<int>(allowed_.n_elem);
+  double b = static_cast<double>(branches);
+
+  arma::vec terms(static_cast<arma::uword>(std::max(0, p - std::max(t, 1) + 1)));
+  arma::uword k = 0;
+
+  for (int d = std::max(t, 1); d <= p; d++) {
+    double dd = static_cast<double>(d);
+    terms(k++) = R::lgammafn(dd + 1.0) - R::lgammafn(dd - t + 1.0) +
+      R::lgammafn(alpha * dd) - R::lgammafn(alpha * dd + b) -
+      zeta * std::log(dd);
+  }
+
+  double out = k == 0 ? R_NegInf : log_sum_exp(terms.head(k));
+  log_v_cache_[key] = out;
+  return out;
+}
+
+// The Polya urn of Linero and Du (2023) Proposition 2, equation (5). Dropping
+// V_{B-1}(Q), which is common to both branches and so cancels, the unnormalized
+// weight on group j is
+//
+//   V_B(Q) * (alpha + m_j)                 when m_j != 0,
+//   V_B(Q + 1) * alpha / (P - Q)           when m_j == 0,
+//
+// where m_j counts the branches already splitting on j, Q is how many groups
+// have any, and B counts the branch being drawn as well as those.
+//
+// So a group the ensemble already uses is reinforced by its own count and a
+// fresh one shares alpha across the groups not yet used, which is where the
+// sparsity comes from: V_B(Q + 1) / V_B(Q) is the price of widening the model.
+arma::uvec Hypers::sample_var_gibbs(int exclude_group) const {
+  arma::vec counts = urn_counts_;
+  double branches = num_branches_;
+
+  // A rule change replaces a branch rather than adding one, so that branch
+  // belongs to neither m_j nor B: equation (5) conditions on every branch *but*
+  // the one being drawn.
+  if (exclude_group >= 0 && exclude_group < num_groups_ &&
+      counts(static_cast<arma::uword>(exclude_group)) > 0.0) {
+    counts(static_cast<arma::uword>(exclude_group)) -= 1.0;
+    branches -= 1.0;
+  }
+
+  arma::vec live = counts.elem(allowed_);
+  int p = static_cast<int>(allowed_.n_elem);
+  int q = static_cast<int>(arma::accu(live > 0.0));
+  int b = static_cast<int>(branches) + 1;
+
+  double log_used = log_v(q, b);
+  double log_fresh = q < p
+    ? log_v(q + 1, b) - std::log(static_cast<double>(p - q))
+    : R_NegInf;
+
+  arma::vec log_w(static_cast<arma::uword>(p));
+
+  for (arma::uword i = 0; i < live.n_elem; i++) {
+    log_w(i) = live(i) > 0.0
+      ? log_used + std::log(alpha + live(i))
+      : log_fresh + std::log(alpha);
+  }
+
+  // Every group fresh and none available is unreachable -- p >= 1 and q <= p, so
+  // q == p means live is strictly positive and the first branch above fired --
+  // but a guard is cheaper than a silent NaN if that ever stops holding.
+  if (!log_w.is_finite() && !arma::any(arma::find_finite(log_w))) {
+    log_w.fill(0.0);
+  }
+
+  arma::vec w = arma::exp(log_w - log_w.max());
+  w /= arma::accu(w);
+
+  int which = sample_class(w);
+  int group = static_cast<int>(allowed_(static_cast<arma::uword>(which)));
+
+  arma::uvec group_var(2);
+  group_var(0) = static_cast<arma::uword>(group);
+  group_var(1) = static_cast<arma::uword>(sample_class_col(group_probs_, group));
+  return group_var;
+}
