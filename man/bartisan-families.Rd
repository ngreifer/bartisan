   \code{binomial()} \tab \code{logit}, \code{probit}, \code{cloglog} \tab 1 \tab none \cr
   \code{poisson()} \tab \code{log} \tab 1 \tab none \cr
   \code{negbin()} \tab \code{log} \tab 1 \tab dispersion \cr
